<div>

<div id="flash_messages">
<% if flash[:error] %>
<div class="error">
    <%= flash[:error] %>
</div>
<% end %>
</div>

<div id="new_task_form">
  <%= form_with url: "/task/add", local: false, data: { controller: "form-reset" } do |form| %>
    <%= form.label :subject, "New Task:" %>
    <%= form.text_field :subject, size: 100, maxlength: 255, data: { "form-reset-target": "input" }, autofocus: true %>
    <%= form.submit "Add", data: { disable_with: "Adding..." } %>
  <% end %>
</div>

<%= button_to "Close list", "/task/close_list", method: :post, class: "button close_list", 
    local: false, data: { disable_with: "Closing..." } %>

<table id="task_list">
  <colgroup>
    <col width="100" />
    <col width="100" />
    <col width="100" />
    <col width="*" />
  </colgroup>
  <tbody id="task_list_body">
  <% @working_list.tasks.each do |task| %>
    <%= render partial: "task_row", locals: { task: task } %>
  <% end %>
  </tbody>
</table>

</div>
