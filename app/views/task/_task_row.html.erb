<tr id="task_<%= task.id %>" class="task-row <%= item_class_of_task(task) %>" data-controller="task-row">
  <td>
    <span class="font-mono text-xs text-gray-500"><%= task.created_at.strftime("%m/%d %H:%M") %></span>
  </td>
  <td>
    <% if task.started? %>
    <span class="font-mono text-xs text-gray-500"><%= task.started_at.strftime("%m/%d %H:%M") %></span>
    <% elsif not task.started? and not task.canceled? %>
    <%= button_to "Start", "/task/start/#{task.id}", method: :post, class: "btn-start", 
        local: false, data: { disable_with: "Starting..." } %>
    <% else %>
    <span class="text-gray-400">-</span>
    <% end %>
  </td>
  <td>
    <% if task.completed? %>
    <span class="font-mono text-xs text-gray-500"><%= task.completed_at.strftime("%m/%d %H:%M") if task.completed? %></span>
    <% elsif not task.started? %>
    <%= button_to "Cancel", "/task/cancel/#{task.id}", method: :post, class: "btn-cancel",
        local: false, data: { disable_with: "Canceling..." } %>
    <% else %>
    <%= button_to "Complete", "/task/complete/#{task.id}", method: :post, class: "btn-complete",
        local: false, data: { disable_with: "Completing..." } %>
    <% end %>
  </td>
  <td class="subject">
    <%= htmlize_subject(task.subject) %>
  </td>
</tr>