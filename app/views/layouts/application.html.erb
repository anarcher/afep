<!DOCTYPE html>
<html>
<head>
  <title>Autofocus</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
</head>
<body data-controller="turbo-stream-actions keyboard-shortcuts" class="font-sans text-xs">
  <div class="p-6">
    <h1 class="text-lg font-bold mb-2">AFEP</h1>
    <small class="text-gray-600">Press 'n' to focus on new task input, Cmd/Ctrl+Enter to submit</small>
  </div>
  
  <%= yield %> 
  
</body>
</html>
